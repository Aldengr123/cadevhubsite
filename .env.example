# ============================================================
#  CADev Hub — modelo do .env (sem valores)
#  Copie para .env e preencha. No servidor, o .env fica em
#  /home/cadevhub.com/.env (FORA do public_html). Ver LEIA-ME.
# ============================================================

# ---- Banco (dados que o CyberPanel gerou ao criar o banco) ----
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Senha para acessar/salvar orçamentos em /orcamentos
ADMIN_TOKEN=

# ---- OpenRouter ----
OPENROUTER_API_KEY=
